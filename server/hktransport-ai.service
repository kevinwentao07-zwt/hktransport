[Unit]
Description=hktransport AI proxy
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 -I /opt/hktransport-ai/ai_proxy.py
EnvironmentFile=-/etc/hktransport/ai.env
EnvironmentFile=-/etc/hktransport/map.env
DynamicUser=yes
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
MemoryMax=128M

[Install]
WantedBy=multi-user.target
